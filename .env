# Application
APP_NAME=LAB51 Auth Core
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://lab51:lab51_secret@localhost:5439/lab51_auth

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=lab51-dev-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Argon2id
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16

# OTP
OTP_LENGTH=6
OTP_TTL_SECONDS=600

# Link Token
LINK_TOKEN_TTL_SECONDS=600

# Rate Limiting
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_WINDOW=60
RATE_LIMIT_REGISTER_PER_IP=5
RATE_LIMIT_REGISTER_WINDOW=3600
RATE_LIMIT_OTP_PER_IDENTITY=3
RATE_LIMIT_OTP_WINDOW=600

# Allowed email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=mail.ru

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173